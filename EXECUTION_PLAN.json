    "transformationRules": {
      "totalRules": 35,
      "categories": [
        {
          "category": "Framework Upgrade",
          "rules": [
            {
              "ruleId": "TR-001",
              "name": ".NET 6 to .NET 8 Upgrade",
              "description": "Update target framework in all .csproj files",
              "before": "<TargetFramework>net6.0</TargetFramework>",
              "after": "<TargetFramework>net8.0</TargetFramework>"
            },
            {
              "ruleId": "TR-002",
              "name": "Package Version Updates",
              "description": "Update all NuGet packages to .NET 8 compatible versions",
              "before": "Microsoft.EntityFrameworkCore.SqlServer Version=\"6.0.19\"",
              "after": "Microsoft.EntityFrameworkCore.SqlServer Version=\"8.0.0\""
            }
          ]
        },
        {
          "category": "Architecture Transformation",
          "rules": [
            {
              "ruleId": "TR-003",
              "name": "Entity Migration to Domain Layer",
              "description": "Move entities from Models to Domain layer",
              "before": "namespace OrbitAOS.V6.Models",
              "after": "namespace OrbitAOS.V6.Domain.Entities"
            },
            {
              "ruleId": "TR-004",
              "name": "Service Layer Introduction",
              "description": "Create service layer for business logic",
              "before": "Direct repository access in controllers",
              "after": "Service injection and usage in controllers"
            },
            {
              "ruleId": "TR-005",
              "name": "Repository Pattern Implementation",
              "description": "Implement generic repository pattern",
              "before": "Direct DbContext usage",
              "after": "IRepository<T> interface usage"
            }
          ]
        },
        {
          "category": "Dependency Injection",
          "rules": [
            {
              "ruleId": "TR-006",
              "name": "Constructor Injection",
              "description": "Use constructor injection for dependencies",
              "before": "private readonly MyService _service = new MyService();",
              "after": "private readonly IMyService _service; public MyController(IMyService service) { _service = service; }"
            },
            {
              "ruleId": "TR-007",
              "name": "Service Registration",
              "description": "Register services in Program.cs",
              "before": "No registration",
              "after": "builder.Services.AddScoped<IMyService, MyService>();"
            }
          ]
        },
        {
          "category": "Async/Await Pattern",
          "rules": [
            {
              "ruleId": "TR-008",
              "name": "Async Controller Actions",
              "description": "Convert synchronous actions to async",
              "before": "public ActionResult Index() { var data = _repo.GetAll(); return View(data); }",
              "after": "public async Task<IActionResult> Index() { var data = await _service.GetAllAsync(); return View(data); }"
            },
            {
              "ruleId": "TR-009",
              "name": "Async Repository Methods",
              "description": "Implement async repository methods",
              "before": "public List<T> GetAll() { return _dbSet.ToList(); }",
              "after": "public async Task<IEnumerable<T>> GetAllAsync() { return await _dbSet.ToListAsync(); }"
            }
          ]
        },
        {
          "category": "Data Access",
          "rules": [
            {
              "ruleId": "TR-010",
              "name": "DbContext Configuration",
              "description": "Configure DbContext with dependency injection",
              "before": "public ApplicationDbContext() : base(\"DefaultConnection\") { }",
              "after": "public ApplicationDbContext(DbContextOptions<ApplicationDbContext> options) : base(options) { }"
            },
            {
              "ruleId": "TR-011",
              "name": "Entity Configuration",
              "description": "Use Fluent API for entity configuration",
              "before": "Data annotations only",
              "after": "protected override void OnModelCreating(ModelBuilder builder) { builder.Entity<T>().HasKey(e => e.Id); }"
            }
          ]
        }
      ]
    },
    "dataStrategy": {
      "approach": "Code-First with Migrations",
      "steps": [
        {
          "step": 1,
          "action": "Create entities in Domain layer",
          "command": "N/A - Manual coding"
        },
        {
          "step": 2,
          "action": "Configure DbContext in Infrastructure layer",
          "command": "N/A - Manual coding"
        },
        {
          "step": 3,
          "action": "Create initial migration",
          "command": "dotnet ef migrations add InitialCreate --startup-project OrbitAOS.V6 --project OrbitAOS.V6.Infrastructure"
        },
        {
          "step": 4,
          "action": "Update database",
          "command": "dotnet ef database update --startup-project OrbitAOS.V6 --project OrbitAOS.V6.Infrastructure"
        },
        {
          "step": 5,
          "action": "Generate SQL script for production",
          "command": "dotnet ef migrations script --startup-project OrbitAOS.V6 --project OrbitAOS.V6.Infrastructure --output migration.sql"
        }
      ],
