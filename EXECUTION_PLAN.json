      { "id": "B04", "severity": "Medium", "title": "Synchronous I/O Operations", "mitigation": "Convert to async/await patterns" },
      { "id": "B05", "severity": "High", "title": "web.config Configuration", "mitigation": "Migrate to appsettings.json" },
      { "id": "B06", "severity": "High", "title": "Custom HTTP Modules", "mitigation": "Replace with ASP.NET Core Middleware" },
