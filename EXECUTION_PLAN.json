      { "id": "B08", "severity": "Medium", "title": "OutputCache Attribute", "mitigation": "Replace with [ResponseCache] and AddResponseCaching()" },
      { "id": "B09", "severity": "Medium", "title": "Child Actions (Html.Action)", "mitigation": "Replace with ViewComponents" },
      { "id": "B10", "severity": "High", "title": ".NET Framework-Only NuGet Packages", "mitigation": "Find .NET 8 compatible alternatives" },
      { "id": "B11", "severity": "Medium", "title": "Deployment Model Changes", "mitigation": "Configure for Kestrel/IIS hosting" },
      { "id": "B12", "severity": "Low", "title": "Missing TempData Provider", "mitigation": "Use default cookie-based TempData" },
      { "id": "B13", "severity": "Medium", "title": "Custom Model Binders", "mitigation": "Rewrite using IModelBinder async API" },
      { "id": "B14", "severity": "Low", "title": "Route Constraints Syntax", "mitigation": "Update to .NET 8 route template syntax" },
      { "id": "B15", "severity": "Low", "title": "Anti-Forgery Token Changes", "mitigation": "Use Tag Helpers (automatic token injection)" },
