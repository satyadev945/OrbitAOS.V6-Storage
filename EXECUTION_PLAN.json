    "blockers": [
      {
        "blockerId": "B-001",
        "severity": "High",
        "title": "Entity Framework 6 to EF Core 8 Migration",
        "description": "If legacy code uses EF6, migration to EF Core 8 requires significant changes",
        "impact": "Data access layer rewrite required",
        "mitigation": "Use repository pattern to abstract data access, implement EF Core repositories",
        "estimatedEffort": "2-3 weeks"
      },
      {
        "blockerId": "B-002",
        "severity": "Medium",
        "title": "Synchronous to Asynchronous Code",
        "description": "Legacy synchronous code needs conversion to async/await",
        "impact": "All data access and I/O operations need updates",
        "mitigation": "Systematic conversion of methods to async, use async all the way",
        "estimatedEffort": "1-2 weeks"
      },
      {
        "blockerId": "B-003",
        "severity": "Medium",
        "title": "Dependency Injection Refactoring",
        "description": "Legacy code may use direct instantiation instead of DI",
        "impact": "Controllers and services need refactoring",
        "mitigation": "Implement constructor injection, register services in Program.cs",
        "estimatedEffort": "1 week"
      },
      {
        "blockerId": "B-004",
        "severity": "Low",
        "title": "Configuration Migration",
        "description": "web.config to appsettings.json migration",
        "impact": "Configuration access patterns change",
        "mitigation": "Use IConfiguration interface, update configuration access code",
        "estimatedEffort": "2-3 days"
      },
      {
        "blockerId": "B-005",
        "severity": "Low",
        "title": "Static File Serving",
        "description": "Content and Scripts folders to wwwroot migration",
        "impact": "File paths and references need updates",
        "mitigation": "Move files to wwwroot, update references in views",
        "estimatedEffort": "1-2 days"
      }
    ],
