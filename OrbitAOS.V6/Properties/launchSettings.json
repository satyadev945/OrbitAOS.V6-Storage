        "ASPNETCORE_ENVIRONMENT": "${ASPNETCORE_ENVIRONMENT:-Development}",
        "AWS_SSM_PARAMETER_STORE_ENABLED": "true",
        "AWS_SECRETS_MANAGER_ENABLED": "true"
      }
