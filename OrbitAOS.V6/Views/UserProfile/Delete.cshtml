@model OrbitAOS.V6.Models.DTOs.UserProfileDto
@{
    ViewData["Title"] = "Delete User Profile";
}

<h1>Delete User Profile</h1>

<div class="alert alert-warning">
    <strong>Warning:</strong> Are you sure you want to delete this user profile? This action cannot be undone.
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Display Name</dt>
            <dd class="col-sm-9">@Model.DisplayName</dd>

            <dt class="col-sm-3">User ID</dt>
            <dd class="col-sm-9">@Model.UserId</dd>

            <dt class="col-sm-3">Bio</dt>
            <dd class="col-sm-9">@(Model.Bio ?? "N/A")</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-3">
    <input type="submit" value="Confirm Delete" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
</form>
