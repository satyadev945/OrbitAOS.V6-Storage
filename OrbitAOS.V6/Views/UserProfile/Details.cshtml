@model OrbitAOS.V6.Models.DTOs.UserProfileDto
@{
    ViewData["Title"] = "User Profile Details";
}

<h1>User Profile Details</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Display Name</dt>
            <dd class="col-sm-9">@Model.DisplayName</dd>

            <dt class="col-sm-3">User ID</dt>
            <dd class="col-sm-9">@Model.UserId</dd>

            <dt class="col-sm-3">Bio</dt>
            <dd class="col-sm-9">@(Model.Bio ?? "N/A")</dd>

            <dt class="col-sm-3">Avatar URL</dt>
            <dd class="col-sm-9">
                @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                {
                    <a href="@Model.AvatarUrl" target="_blank">@Model.AvatarUrl</a>
                }
                else
                {
                    <span>N/A</span>
                }
            </dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                @if (Model.IsActive)
                {
                    <span class="badge bg-success">Active</span>
                }
                else
                {
                    <span class="badge bg-secondary">Inactive</span>
                }
            </dd>

            <dt class="col-sm-3">Created At</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC</dd>

            @if (Model.UpdatedAt.HasValue)
            {
                <dt class="col-sm-3">Updated At</dt>
                <dd class="col-sm-9">@Model.UpdatedAt.Value.ToString("yyyy-MM-dd HH:mm:ss") UTC</dd>
            }
        </dl>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
</div>
