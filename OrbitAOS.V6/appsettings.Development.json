{
  // =============================================================================
  // appsettings.Development.json - Development Environment Configuration
  //
  // Migration Notes:
  //   - Overrides appsettings.json for Development environment
  //   - Replaces web.config system.web/compilation debug="true"
  //   - Enables detailed EF Core SQL logging in development
  //   - ASPNETCORE_ENVIRONMENT=Development activates this file
  // =============================================================================
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  }
}
