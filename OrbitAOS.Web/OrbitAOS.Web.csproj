<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OrbitAOS.Web</RootNamespace>
    <AssemblyName>OrbitAOS.Web</AssemblyName>
    <UserSecretsId>aspnet-OrbitAOS.Web-afe03967-a771-44f8-b4ff-ee887e025b4f</UserSecretsId>
    <!-- Enable .NET 8 performance and security features -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OrbitAOS.Application\OrbitAOS.Application.csproj" />
    <ProjectReference Include="..\OrbitAOS.Infrastructure\OrbitAOS.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ASP.NET Core Identity UI scaffolded pages (upgraded to 8.0.0) -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="8.0.0" />
    <!-- Required for AddDatabaseDeveloperPageExceptionFilter() used in Infrastructure DI -->
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="8.0.0" />
  </ItemGroup>

</Project>
