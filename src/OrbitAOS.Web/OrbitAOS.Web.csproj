<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OrbitAOS.Web</RootNamespace>
    <AssemblyName>OrbitAOS.Web</AssemblyName>
    <UserSecretsId>aspnet-OrbitAOS.Web-afe03967-a771-44f8-b4ff-ee887e025b4f</UserSecretsId>
    <!-- Treat warnings as errors in Release builds for code quality -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OrbitAOS.Application\OrbitAOS.Application.csproj" />
    <ProjectReference Include="..\OrbitAOS.Infrastructure\OrbitAOS.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ASP.NET Core Identity scaffolded UI pages -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="8.0.12" />
  </ItemGroup>

</Project>
