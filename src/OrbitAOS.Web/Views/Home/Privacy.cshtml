@{
    ViewData["Title"] = "Privacy Policy";
}
<h1>@ViewData["Title"]</h1>

<p class="lead">Use this page to detail your site's privacy policy.</p>

<div class="card mt-3">
    <div class="card-body">
        <h5 class="card-title">Data Collection</h5>
        <p class="card-text">
            OrbitAOS collects only the information necessary to provide its services.
            This includes account information such as email address and display name.
        </p>
    </div>
</div>

<div class="card mt-3">
    <div class="card-body">
        <h5 class="card-title">Data Usage</h5>
        <p class="card-text">
            Collected data is used solely for authentication and user profile management.
            We do not share your data with third parties.
        </p>
    </div>
</div>

<div class="card mt-3">
    <div class="card-body">
        <h5 class="card-title">Contact</h5>
        <p class="card-text">
            For privacy-related inquiries, please contact the system administrator.
        </p>
    </div>
</div>
