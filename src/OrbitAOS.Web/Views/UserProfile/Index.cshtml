@model IReadOnlyList<OrbitAOS.Application.DTOs.UserProfileDto>
@{
    ViewData["Title"] = "User Profiles";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>User Profiles</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Create New
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No user profiles found. <a asp-action="Create" class="alert-link">Create the first one.</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Display Name</th>
                    <th>Email</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var profile in Model)
                {
                    <tr>
                        <td>@profile.DisplayName</td>
                        <td>@profile.Email</td>
                        <td>
                            @if (profile.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td>@profile.CreatedAt.ToString("yyyy-MM-dd")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@profile.Id" class="btn btn-sm btn-outline-info">Details</a>
                            <a asp-action="Edit" asp-route-id="@profile.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                            <a asp-action="Delete" asp-route-id="@profile.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted">Total: @Model.Count profile(s)</p>
}
